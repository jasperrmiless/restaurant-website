const toggle = document.querySelector(".menu-toggle");
const nav = document.querySelector(".nav-links");

toggle.addEventListener("click", () => {
  const open = nav.classList.toggle("open");
  toggle.setAttribute("aria-expanded", open);
});

document.querySelectorAll(".nav-links a").forEach(link => {
  link.addEventListener("click", () => nav.classList.remove("open"));
});

const form = document.getElementById("reservationForm");
const message = document.getElementById("formMessage");

form.addEventListener("submit", (event) => {
  event.preventDefault();
  const name = document.getElementById("name").value.trim();
  message.textContent = `Thanks, ${name}! Your reservation request has been received for this demo.`;
  form.reset();
});

:root{
  --bg:#f8f5ef;
  --paper:#fffdf8;
  --ink:#1d1b18;
  --muted:#716c63;
  --accent:#b75b36;
  --line:#ded8cd;
  --dark:#24211d;
  --max:1120px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:"DM Sans",sans-serif;background:var(--bg);color:var(--ink);line-height:1.6}
a{text-decoration:none;color:inherit}
.container{width:min(var(--max),92%);margin:auto}
.header{position:fixed;top:0;left:0;width:100%;z-index:20;background:rgba(248,245,239,.9);backdrop-filter:blur(14px);border-bottom:1px solid rgba(222,216,205,.7)}
.nav{height:76px;display:flex;align-items:center;justify-content:space-between}
.logo{font:700 1.6rem "Playfair Display",serif}.logo span{color:var(--accent)}
.nav-links{display:flex;align-items:center;gap:28px;font-size:.92rem;font-weight:600}
.nav-links a{transition:.2s}.nav-links a:hover{color:var(--accent)}
.nav-cta{padding:10px 16px;border:1px solid var(--ink);border-radius:999px}
.menu-toggle{display:none;border:0;background:none;font-size:1.5rem}
.hero{min-height:760px;display:grid;align-items:center;position:relative;background:
linear-gradient(90deg,rgba(29,27,24,.85),rgba(29,27,24,.35)),
url("https://images.unsplash.com/photo-1515003197210-e0cd71810b5f?auto=format&fit=crop&w=1800&q=85") center/cover}
.hero-content{padding-top:76px;color:#fff;position:relative;z-index:2}
.eyebrow{font-size:.75rem;letter-spacing:.18em;font-weight:700;margin-bottom:14px;color:var(--accent)}
.hero .eyebrow{color:#f0c5a9}
h1,h2{font-family:"Playfair Display",serif;line-height:1.05}
h1{font-size:clamp(3.4rem,8vw,6.8rem);max-width:760px}
h1 span{font-style:italic;color:#f1c7ae}
.hero-text{max-width:560px;margin:26px 0;font-size:1.08rem;color:#eee}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap}
.button{display:inline-flex;align-items:center;justify-content:center;border:0;padding:13px 21px;border-radius:999px;font-weight:700;cursor:pointer;transition:transform .2s,opacity .2s}
.button:hover{transform:translateY(-2px);opacity:.92}
.primary{background:var(--accent);color:#fff}.secondary{border:1px solid #fff;color:#fff;background:transparent}
.section{padding:100px 0}
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}
h2{font-size:clamp(2.4rem,5vw,4.2rem)}
.two-col p{color:var(--muted);margin-bottom:18px}
.text-link{font-weight:700;color:var(--accent);display:inline-block;margin-top:10px}
.menu-section{background:var(--paper)}
.section-heading{text-align:center;max-width:650px;margin:0 auto 50px}
.section-heading p:last-child{color:var(--muted)}
.menu-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.menu-card{display:flex;gap:18px;padding:24px;background:var(--bg);border:1px solid var(--line);border-radius:18px}
.dish-icon{width:52px;height:52px;display:grid;place-items:center;background:#eee7dc;border-radius:14px;font-size:1.5rem;flex:none}
.dish-top{display:flex;justify-content:space-between;gap:30px}.dish-top span{font-weight:700;color:var(--accent)}
.menu-card h3{font-size:1.08rem}.menu-card p{color:var(--muted);font-size:.92rem;margin-top:4px}
.feature{background:var(--dark);color:#fff}
.feature-box{display:grid;grid-template-columns:1.2fr .8fr;gap:70px;align-items:center}
.feature p:not(.eyebrow){color:#c8c1b7;max-width:580px;margin:20px 0 28px}
.feature-stats{display:grid;grid-template-columns:1fr;gap:1px;background:#4a453e}
.feature-stats div{padding:28px;background:var(--dark);display:flex;justify-content:space-between;align-items:center}
.feature-stats strong{font:700 2rem "Playfair Display",serif}.feature-stats span{color:#bdb5aa}
.gallery-grid{display:grid;grid-template-columns:1.2fr .8fr;grid-template-rows:230px 230px;gap:16px}
.gallery-item{border-radius:20px;overflow:hidden;position:relative;display:flex;align-items:end;padding:22px;color:#fff;font-weight:700;background-position:center;background-size:cover}
.gallery-item:after{content:"";position:absolute;inset:0;background:linear-gradient(transparent,rgba(0,0,0,.65))}
.gallery-item span{position:relative;z-index:2}.g1{grid-row:span 2;background-image:url("https://images.unsplash.com/photo-1540189549336-e6e99c3679fe?auto=format&fit=crop&w=1000&q=80")}
.g2{background-image:url("https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=900&q=80")}
.g3{background-image:url("https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=900&q=80")}
.g4{display:none}
.reservation{background:#eee8de}
.reservation-box{display:grid;grid-template-columns:.8fr 1.2fr;gap:60px;align-items:center}
.reservation-box p:not(.eyebrow){color:var(--muted);margin-top:16px}
.reservation-form{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.reservation-form input,.reservation-form select{width:100%;padding:14px 16px;border:1px solid var(--line);border-radius:12px;background:#fff;font:inherit;color:var(--ink)}
.reservation-form button{grid-column:1/-1}
.form-message{grid-column:1/-1;color:var(--accent)!important;font-weight:600;margin:0!important}
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px}
.contact p{color:var(--muted);margin-top:18px}.contact-card{border-left:1px solid var(--line);padding-left:50px;display:flex;flex-direction:column;gap:12px}.contact-card h3{font-size:1.3rem}
.footer{padding:28px 0;border-top:1px solid var(--line);font-size:.85rem;color:var(--muted)}
.footer-inner{display:flex;justify-content:space-between;gap:20px}.footer a{color:var(--accent)}
@media(max-width:760px){
  .nav-links{display:none;position:absolute;top:76px;left:0;width:100%;padding:22px;background:var(--paper);flex-direction:column;align-items:flex-start;border-bottom:1px solid var(--line)}
  .nav-links.open{display:flex}.menu-toggle{display:block}
  .hero{min-height:700px}.two-col,.feature-box,.reservation-box,.contact-grid{grid-template-columns:1fr;gap:40px}
  .menu-grid{grid-template-columns:1fr}.gallery-grid{grid-template-columns:1fr;grid-template-rows:260px 200px}.g1{grid-row:auto}.g3,.g4{display:none}
  .contact-card{border-left:0;border-top:1px solid var(--line);padding:30px 0 0}
  .reservation-form{grid-template-columns:1fr}.reservation-form button{grid-column:auto}
}
